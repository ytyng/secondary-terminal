{
  "name": "secondary-terminal",
  "displayName": "Secondary Sidebar Terminal",
  "description": "A full-featured PTY terminal in the VSCode sidebar, with multi-tab support and a built-in command editor.",
  "version": "0.17.311",
  "publisher": "ytyng",
  "icon": "icon.png",
  "license": "MIT",
  "author": "ytyng",
  "homepage": "https://github.com/ytyng/secondary-terminal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ytyng/secondary-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/ytyng/secondary-terminal/issues"
  },
  "keywords": [
    "terminal",
    "sidebar",
    "pty",
    "shell",
    "tabs"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartup",
    "onView:secondaryTerminalDropZone"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalContainer",
          "title": "Secondary Terminal",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "terminalContainer": [
        {
          "type": "webview",
          "id": "secondaryTerminalMainView",
          "name": "Terminal",
          "icon": "$(terminal)",
          "retainContextWhenHidden": true
        },
        {
          "id": "secondaryTerminalDropZone",
          "name": "Drop Zone",
          "icon": "$(file-media)",
          "when": "secondaryTerminal:dropZoneVisible"
        }
      ]
    },
    "commands": [
      {
        "command": "secondaryTerminal.focus",
        "title": "Focus Terminal",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.clear",
        "title": "Clear Terminal",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.sendMainEditorSelection",
        "title": "Send Main Editor Selection to Secondary Terminal",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.sendMainTerminalSelection",
        "title": "Send Main Terminal Selection to Secondary Terminal",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.copyMainEditorSelection",
        "title": "Copy Main Editor Selection with Location",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.copyMainTerminalSelection",
        "title": "Copy Main Terminal Selection with Location",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.restart",
        "title": "Restart Terminal",
        "category": "Secondary Terminal",
        "icon": "$(refresh)"
      },
      {
        "command": "secondaryTerminal.refreshRenderer",
        "title": "Refresh Renderer (glyph atlas)",
        "category": "Secondary Terminal",
        "icon": "$(symbol-color)"
      },
      {
        "command": "secondaryTerminal.showLogs",
        "title": "Show Logs",
        "category": "Secondary Terminal",
        "icon": "$(output)"
      },
      {
        "command": "secondaryTerminal.toggleDropZone",
        "title": "Toggle Drop Zone",
        "category": "Secondary Terminal",
        "icon": "$(file-media)"
      },
      {
        "command": "secondaryTerminal.pasteImage",
        "title": "Paste Image from Clipboard",
        "category": "Secondary Terminal"
      },
      {
        "command": "secondaryTerminal.toggleClaudeSandbox",
        "title": "Toggle Claude Sandbox",
        "category": "Secondary Terminal"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "secondaryTerminal.toggleDropZone",
          "when": "view == secondaryTerminalMainView",
          "group": "navigation"
        },
        {
          "command": "secondaryTerminal.restart",
          "when": "view == secondaryTerminalMainView",
          "group": "navigation"
        },
        {
          "command": "secondaryTerminal.refreshRenderer",
          "when": "view == secondaryTerminalMainView",
          "group": "navigation"
        },
        {
          "command": "secondaryTerminal.showLogs",
          "when": "view == secondaryTerminalMainView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "secondaryTerminal.sendMainEditorSelection",
        "key": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "secondaryTerminal.sendMainTerminalSelection",
        "key": "cmd+l",
        "when": "terminalFocus"
      },
      {
        "command": "secondaryTerminal.copyMainEditorSelection",
        "key": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "secondaryTerminal.copyMainTerminalSelection",
        "key": "cmd+shift+l",
        "when": "terminalFocus"
      },
      {
        "command": "secondaryTerminal.toggleClaudeSandbox",
        "key": "cmd+ctrl+s",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Secondary Terminal",
      "properties": {
        "secondaryTerminal.startupCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.startupCommands.description%"
        },
        "secondaryTerminal.maxHistoryLines": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "description": "%configuration.maxHistoryLines.description%"
        },
        "secondaryTerminal.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.notifications.enabled.description%"
        },
        "secondaryTerminal.notifications.flashBackground": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.notifications.flashBackground.description%"
        },
        "secondaryTerminal.fontFamily": {
          "type": "string",
          "default": "\"RobotoMono Nerd Font Mono\", \"RobotoMono Nerd Font\", \"Roboto Mono\", Consolas, \"Courier New\", monospace",
          "description": "%configuration.fontFamily.description%"
        },
        "secondaryTerminal.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 6,
          "maximum": 32,
          "description": "%configuration.fontSize.description%"
        },
        "secondaryTerminal.lineHeight": {
          "type": "number",
          "default": 1.2,
          "minimum": 1,
          "maximum": 2,
          "description": "%configuration.lineHeight.description%"
        },
        "secondaryTerminal.letterSpacing": {
          "type": "number",
          "default": 0,
          "description": "%configuration.letterSpacing.description%"
        },
        "secondaryTerminal.editorHeight": {
          "type": "number",
          "default": 200,
          "minimum": 40,
          "maximum": 1000,
          "description": "%configuration.editorHeight.description%"
        },
        "secondaryTerminal.layout.widthAdjustment": {
          "type": "number",
          "default": 0.88,
          "minimum": 0.5,
          "maximum": 1.5,
          "description": "%configuration.layout.widthAdjustment.description%"
        },
        "secondaryTerminal.layout.heightAdjustment": {
          "type": "number",
          "default": 1.34,
          "minimum": 0.5,
          "maximum": 2,
          "description": "%configuration.layout.heightAdjustment.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run update-version && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "tsc -watch -p ./",
    "clean": "rm -rf out/",
    "rebuild": "npm ci && npm run clean && npm run compile",
    "update-version": "node scripts/update-version.js",
    "increment-version": "npm version patch && npm run update-version",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "ace-builds": "^1.43.2"
  }
}
